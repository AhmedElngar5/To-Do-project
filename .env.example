# Ahmed OS — Environment Configuration Template
# Copy this file to .env and configure your environment-specific values.

# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development

# Database Connection String (SQL Server)
# For LocalDB: Server=(localdb)\mssqllocaldb;Database=AhmedOS;Trusted_Connection=True;MultipleActiveResultSets=true
# For Docker / Remote SQL: Server=sqlserver;Database=AhmedOS;User Id=sa;Password=Your_Strong_Password123!;TrustServerCertificate=True;MultipleActiveResultSets=true
ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=AhmedOS;Trusted_Connection=True;MultipleActiveResultSets=true

# Docker Compose SQL Server SA Password
MSSQL_SA_PASSWORD=Your_Strong_Password123!

# Initial Admin Credentials (Seeded on first startup if no user exists)
INITIAL_ADMIN_EMAIL=ahmed@ahmeddos.local
INITIAL_ADMIN_PASSWORD=Ahmed@OS2024!

# Optional External AI API Keys (Local rule-based copilot is used by default)
OPENAI_API_KEY=
GEMINI_API_KEY=
