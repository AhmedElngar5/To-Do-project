@page
@using AhmedOS.Infrastructure.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AhmedOSDbContext Db
@inject UserManager<ApplicationUser> UserManager
@model AhmedOS.Web.Pages.DEPIModel
@{
    ViewData["Title"] = "DEPI";
    var userId = UserManager.GetUserId(User);
    var modules = await Db.DEPIModules.Where(m => m.UserId == userId).Include(m => m.Sessions).OrderBy(m => m.SortOrder).ToListAsync();
    var totalSessions = modules.Sum(m => m.Sessions.Count);
    var attendedSessions = modules.Sum(m => m.Sessions.Count(s => s.IsAttended));
    var completedModules = modules.Count(m => m.IsCompleted);
    var avgProgress = modules.Count > 0 ? (int)modules.Average(m => m.Progress) : 0;
}

<div class="animate-fade-in">
    <div class="section-header">
        <div>
            <h1 class="section-title">📋 DEPI Training</h1>
            <p class="section-subtitle">Digital Egypt Pioneers Initiative — track your modules and sessions</p>
        </div>
        <div>
            <button class="btn btn-primary btn-sm" onclick="document.getElementById('addModuleModal').classList.add('active')">
                ✚ Add Module
            </button>
        </div>
    </div>

    <!-- STATS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-6);">
        <div class="card card-compact"><div class="card-body stat-widget"><span class="stat-label">Modules</span><span class="stat-value">@modules.Count</span></div></div>
        <div class="card card-compact"><div class="card-body stat-widget"><span class="stat-label">Completed</span><span class="stat-value">@completedModules</span></div></div>
        <div class="card card-compact"><div class="card-body stat-widget"><span class="stat-label">Avg Progress</span><span class="stat-value">@avgProgress%</span></div></div>
        <div class="card card-compact"><div class="card-body stat-widget"><span class="stat-label">Attendance</span><span class="stat-value">@attendedSessions/@totalSessions</span></div></div>
    </div>

    <div class="widget-grid">
        <!-- MODULES -->
        <div class="card" style="grid-column: 1 / -1;">
            <div class="card-header">
                <span class="card-title">📦 Training Modules</span>
            </div>
            <div class="card-body">
                @if (modules.Count == 0)
                {
                    <div class="empty-state" style="padding: var(--space-8) var(--space-4);">
                        <div class="empty-state-icon">📋</div>
                        <div class="empty-state-title">No DEPI modules yet</div>
                        <div class="empty-state-text">Add your DEPI training modules to track progress and attendance.</div>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                        @foreach (var mod in modules)
                        {
                            var sessionCount = mod.Sessions.Count;
                            var attended = mod.Sessions.Count(s => s.IsAttended);
                            var statusBadge = mod.IsCompleted ? "badge-success" : (mod.Progress > 0 ? "badge-primary" : "badge-neutral");
                            var statusText = mod.IsCompleted ? "Completed" : (mod.Progress > 0 ? "In Progress" : "Not Started");
                            <div class="card" style="background: var(--bg-elevated);">
                                <div class="card-body" style="padding: var(--space-4);">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-2);">
                                        <div>
                                            <div style="font-weight: var(--weight-semibold); font-size: var(--text-base);">
                                                @if (mod.IsCompleted) { <span>✅</span> }
                                                @mod.Name
                                            </div>
                                            @if (!string.IsNullOrEmpty(mod.Description))
                                            {
                                                <div class="text-sm text-secondary" style="margin-top: 2px;">@mod.Description</div>
                                            }
                                        </div>
                                        <span class="badge @statusBadge">@statusText</span>
                                    </div>

                                    <div class="progress-bar" style="margin-bottom: var(--space-2);">
                                        <div class="progress-bar-fill" style="width: @mod.Progress%;"></div>
                                    </div>

                                    <div style="display: flex; justify-content: space-between; font-size: var(--text-xs); color: var(--text-tertiary); margin-bottom: var(--space-3);">
                                        <span>Progress: @mod.Progress%</span>
                                        <span>Sessions: @attended/@sessionCount attended</span>
                                    </div>

                                    @if (mod.StartDate.HasValue || mod.EndDate.HasValue)
                                    {
                                        <div class="text-xs text-tertiary" style="margin-bottom: var(--space-2);">
                                            📅 @(mod.StartDate?.ToString("MMM d") ?? "?") — @(mod.EndDate?.ToString("MMM d") ?? "?")
                                        </div>
                                    }

                                    <!-- Sessions list -->
                                    <div style="margin-top: var(--space-2); padding-top: var(--space-2); border-top: 1px solid var(--border-secondary);">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2);">
                                            <div class="text-xs text-tertiary" style="font-weight: var(--weight-medium);">Sessions (@attended/@sessionCount):</div>
                                            <button type="button" class="btn btn-ghost btn-xs" onclick="openSessionModal(@mod.Id, '@mod.Name')" style="font-size: 11px;">
                                                ✚ Add Session
                                            </button>
                                        </div>
                                        @if (sessionCount > 0)
                                        {
                                            @foreach (var session in mod.Sessions.OrderBy(s => s.SessionDate))
                                            {
                                                <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-1) 0; font-size: var(--text-sm);">
                                                    <div style="display: flex; align-items: center; gap: var(--space-2);">
                                                        <form method="post" asp-page-handler="ToggleAttendance" style="margin: 0;">
                                                            <input type="hidden" name="sessionId" value="@session.Id" />
                                                            <button type="submit" class="btn btn-ghost btn-xs" style="padding: 2px 4px; font-size: 14px;" title="Toggle attendance">
                                                                @(session.IsAttended ? "✅" : "⭕")
                                                            </button>
                                                        </form>
                                                        <span style="@(session.IsAttended ? "color: var(--text-primary);" : "color: var(--text-secondary);")">@session.Title</span>
                                                    </div>
                                                    <div style="display: flex; align-items: center; gap: var(--space-2);">
                                                        <span class="text-xs text-tertiary">@(session.SessionDate?.ToString("MMM d") ?? "")</span>
                                                        <span class="badge badge-neutral" style="font-size: 10px;">@session.DurationMinutes min</span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-xs text-tertiary" style="font-style: italic;">No sessions scheduled yet.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ADD MODULE MODAL -->
<div class="modal-overlay" id="addModuleModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">📦 Add DEPI Training Module</h3>
            <button type="button" class="modal-close" onclick="document.getElementById('addModuleModal').classList.remove('active')">✕</button>
        </div>
        <form method="post" asp-page-handler="AddModule">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Module Name *</label>
                    <input type="text" name="name" required placeholder="e.g. Advanced C# & LINQ, ASP.NET Core Web API" autofocus />
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea name="description" rows="2" placeholder="Key topics and deliverables covered..."></textarea>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Start Date</label>
                        <input type="date" name="startDate" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">End Date</label>
                        <input type="date" name="endDate" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Sort Order</label>
                    <input type="number" name="sortOrder" value="1" min="1" max="50" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('addModuleModal').classList.remove('active')">Cancel</button>
                <button type="submit" class="btn btn-primary">Create Module</button>
            </div>
        </form>
    </div>
</div>

<!-- ADD SESSION MODAL -->
<div class="modal-overlay" id="addSessionModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title" id="sessionModalTitle">📅 Add DEPI Session</h3>
            <button type="button" class="modal-close" onclick="document.getElementById('addSessionModal').classList.remove('active')">✕</button>
        </div>
        <form method="post" asp-page-handler="AddSession">
            @Html.AntiForgeryToken()
            <input type="hidden" name="moduleId" id="sessionModuleId" />
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Session Title *</label>
                    <input type="text" name="title" required placeholder="e.g. Session 1: Entity Framework Core Deep Dive" autofocus />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Session Date</label>
                        <input type="datetime-local" name="sessionDate" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Duration (minutes)</label>
                        <input type="number" name="durationMinutes" value="120" min="30" step="15" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Agenda / Notes</label>
                    <textarea name="notes" rows="2" placeholder="Topics, homework, references..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('addSessionModal').classList.remove('active')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Session</button>
            </div>
        </form>
    </div>
</div>

<script>
function openSessionModal(moduleId, moduleName) {
    document.getElementById('sessionModuleId').value = moduleId;
    document.getElementById('sessionModalTitle').textContent = '📅 Add Session — ' + moduleName;
    document.getElementById('addSessionModal').classList.add('active');
}
</script>
