@page
@using AhmedOS.Infrastructure.Data
@using AhmedOS.Domain.Enums
@using AhmedOS.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AhmedOSDbContext Db
@inject UserManager<ApplicationUser> UserManager
@model AhmedOS.Web.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
    var userId = UserManager.GetUserId(User);
    var user = await UserManager.FindByIdAsync(userId!);
    var settings = await Db.UserSettings.FirstOrDefaultAsync(s => s.UserId == userId) ?? new UserSettings();
    var categoryCount = await Db.Categories.CountAsync(c => c.UserId == userId);
    var tagCount = await Db.Tags.CountAsync(t => t.UserId == userId);
}

<div class="animate-fade-in">
    <div class="section-header">
        <div>
            <h1 class="section-title">⚙️ Settings</h1>
            <p class="section-subtitle">Customize your Ahmed OS experience</p>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: var(--space-4);">
        <!-- PROFILE -->
        <div class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="card-title">👤 Profile</span>
                <button type="button" class="btn btn-ghost btn-xs" onclick="document.getElementById('editProfileModal').classList.add('active')">
                    ✏️ Edit Profile
                </button>
            </div>
            <div class="card-body" style="padding: var(--space-4);">
                <div style="display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4);">
                    <div style="width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-info)); display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: var(--weight-bold); color: white;">
                        @(user?.FullName?[0] ?? 'A')
                    </div>
                    <div>
                        <div style="font-weight: var(--weight-semibold); font-size: var(--text-lg);">@(user?.FullName ?? "Ahmed")</div>
                        <div class="text-sm text-secondary">@(user?.Email ?? "")</div>
                        <div class="text-xs text-tertiary" style="margin-top: 2px;">Member since @(user?.CreatedAt.ToString("MMM yyyy") ?? "—")</div>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div style="padding: var(--space-3); background: var(--bg-elevated); border-radius: var(--radius-md); text-align: center;">
                        <div class="text-xs text-tertiary">Categories</div>
                        <div style="font-weight: var(--weight-semibold); font-size: var(--text-lg);">@categoryCount</div>
                    </div>
                    <div style="padding: var(--space-3); background: var(--bg-elevated); border-radius: var(--radius-md); text-align: center;">
                        <div class="text-xs text-tertiary">Tags</div>
                        <div style="font-weight: var(--weight-semibold); font-size: var(--text-lg);">@tagCount</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- WORK PREFERENCES -->
        <div class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="card-title">🕐 Work Preferences</span>
                <button type="button" class="btn btn-ghost btn-xs" onclick="document.getElementById('editPreferencesModal').classList.add('active')">
                    ✏️ Edit Preferences
                </button>
            </div>
            <div class="card-body" style="padding: var(--space-4);">
                <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Work Start Time</span>
                        <span style="font-weight: var(--weight-medium);">@(settings.WorkStartTime ?? "09:00")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Work End Time</span>
                        <span style="font-weight: var(--weight-medium);">@(settings.WorkEndTime ?? "17:00")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Max Deep Work (hours)</span>
                        <span style="font-weight: var(--weight-medium);">@settings.MaxDeepWorkHours</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Max Study (hours)</span>
                        <span style="font-weight: var(--weight-medium);">@settings.MaxStudyHours</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Default Task Duration</span>
                        <span style="font-weight: var(--weight-medium);">@settings.DefaultTaskDurationMinutes min</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0;">
                        <span class="text-sm">Break Duration</span>
                        <span style="font-weight: var(--weight-medium);">@settings.DefaultBreakMinutes min</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- APPEARANCE -->
        <div class="card">
            <div class="card-header"><span class="card-title">🎨 Appearance</span></div>
            <div class="card-body" style="padding: var(--space-4);">
                <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Theme</span>
                        <span class="badge badge-primary">@settings.Theme</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Language</span>
                        <span style="font-weight: var(--weight-medium);">@settings.Language</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Timezone</span>
                        <span style="font-weight: var(--weight-medium);">@settings.Timezone</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0;">
                        <span class="text-sm">Week Starts On</span>
                        <span style="font-weight: var(--weight-medium);">@(settings.WeekStartDay == 0 ? "Sunday" : "Monday")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ENERGY & FOCUS -->
        <div class="card">
            <div class="card-header"><span class="card-title">⚡ Energy & Focus</span></div>
            <div class="card-body" style="padding: var(--space-4);">
                <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Preferred Deep Work Time</span>
                        <span class="badge badge-info">@settings.PreferredDeepWorkTime</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <span class="text-sm">Preferred Study Time</span>
                        <span class="badge badge-info">@settings.PreferredStudyTime</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0;">
                        <span class="text-sm">Notifications</span>
                        <span class="badge @(settings.NotificationsEnabled ? "badge-success" : "badge-neutral")">@(settings.NotificationsEnabled ? "Enabled" : "Disabled")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- AI & INTEGRATIONS -->
        <div class="card">
            <div class="card-header">
                <span class="card-title">✨ AI Copilot & Cloud Integrations</span>
            </div>
            <div class="card-body" style="padding: var(--space-4);">
                <form method="post" asp-page-handler="UpdateIntegrations">
                    @Html.AntiForgeryToken()
                    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                        <div class="form-group">
                            <label class="form-label">
                                Google Gemini API Key
                                <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener" class="text-xs" style="color: var(--accent); margin-left: 8px;">Get Free Key from Google AI Studio ↗</a>
                            </label>
                            <input type="password" name="geminiApiKey" value="@settings.GeminiApiKey" placeholder="AIzaSy..." />
                            <div class="text-xs text-secondary" style="margin-top: 4px;">
                                @if (!string.IsNullOrEmpty(settings.GeminiApiKey))
                                {
                                    <span style="color: var(--color-success); font-weight: var(--weight-bold);">✨ Gemini 1.5 Flash Enabled</span>
                                }
                                else
                                {
                                    <span>⚡ Offline Local AI active. Paste key to unlock real generative AI.</span>
                                }
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">GitHub Username</label>
                            <div style="display: flex; gap: var(--space-2);">
                                <input type="text" name="githubUsername" value="@(settings.GithubUsername ?? "AhmedElngar5")" placeholder="AhmedElngar5" style="flex: 1;" />
                                <a href="https://github.com/@(settings.GithubUsername ?? "AhmedElngar5")" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center;">View Profile ↗</a>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: flex-end;">
                            <button type="submit" class="btn btn-primary btn-sm">💾 Save Integrations</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- DATA -->
        <div class="card">
            <div class="card-header"><span class="card-title">💾 Data</span></div>
            <div class="card-body" style="padding: var(--space-4);">
                <div class="text-sm text-secondary" style="margin-bottom: var(--space-3);">Manage your data and account.</div>
                <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                    <div style="padding: var(--space-3); background: var(--bg-elevated); border-radius: var(--radius-md); display: flex; justify-content: space-between; align-items: center;">
                        <span class="text-sm">Database</span>
                        <span class="badge badge-success">SQL Server LocalDB</span>
                    </div>
                    <div style="padding: var(--space-3); background: var(--bg-elevated); border-radius: var(--radius-md); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div class="text-sm font-medium">Export Full Backup</div>
                            <div class="text-xs text-secondary">Download complete JSON archive of all your OS data</div>
                        </div>
                        <a href="/api/data/export" class="btn btn-secondary btn-sm" download>📥 Export JSON</a>
                    </div>
                    <div style="padding: var(--space-3); background: var(--bg-elevated); border-radius: var(--radius-md); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div class="text-sm font-medium">Export Tasks CSV</div>
                            <div class="text-xs text-secondary">Export all tasks with priorities and dates</div>
                        </div>
                        <a href="/api/data/export-tasks-csv" class="btn btn-ghost btn-sm" download>📊 Export CSV</a>
                    </div>
                    <div style="padding: var(--space-3); background: var(--bg-elevated); border-radius: var(--radius-md); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div class="text-sm font-medium">Export iCalendar (.ics)</div>
                            <div class="text-xs text-secondary">Sync schedule, lectures, DEPI, and deadlines with Google or Apple Calendar</div>
                        </div>
                        <a href="/api/calendar/export.ics" class="btn btn-secondary btn-sm" download>📅 Export .ics</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- EDIT PROFILE MODAL -->
<div class="modal-overlay" id="editProfileModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">👤 Edit Profile</h3>
            <button type="button" class="modal-close" onclick="document.getElementById('editProfileModal').classList.remove('active')">✕</button>
        </div>
        <form method="post" asp-page-handler="UpdateProfile">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Full Name *</label>
                    <input type="text" name="fullName" required value="@(user?.FullName ?? "Ahmed Hany Kamal El Nagar")" autofocus />
                </div>
                <div class="form-group">
                    <label class="form-label">Email Address (Read Only)</label>
                    <input type="text" value="@(user?.Email ?? "")" disabled style="opacity: 0.7;" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('editProfileModal').classList.remove('active')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Profile</button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT PREFERENCES MODAL -->
<div class="modal-overlay" id="editPreferencesModal">
    <div class="modal" style="max-width: 600px;">
        <div class="modal-header">
            <h3 class="modal-title">⚙️ Edit Work Preferences</h3>
            <button type="button" class="modal-close" onclick="document.getElementById('editPreferencesModal').classList.remove('active')">✕</button>
        </div>
        <form method="post" asp-page-handler="UpdatePreferences">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Work Start Time</label>
                        <input type="time" name="workStartTime" value="@(settings.WorkStartTime ?? "09:00")" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Work End Time</label>
                        <input type="time" name="workEndTime" value="@(settings.WorkEndTime ?? "17:00")" />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Max Deep Work (hours/day)</label>
                        <input type="number" name="maxDeepWorkHours" value="@settings.MaxDeepWorkHours" min="1" max="12" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Max Study (hours/day)</label>
                        <input type="number" name="maxStudyHours" value="@settings.MaxStudyHours" min="1" max="12" />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Default Task Duration (min)</label>
                        <input type="number" name="defaultTaskDurationMinutes" value="@settings.DefaultTaskDurationMinutes" min="5" step="5" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Break Duration (min)</label>
                        <input type="number" name="defaultBreakMinutes" value="@settings.DefaultBreakMinutes" min="5" step="5" />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Preferred Deep Work Time</label>
                        <select name="preferredDeepWorkTime">
                            <option value="@TimeOfDay.Morning" selected="@(settings.PreferredDeepWorkTime == TimeOfDay.Morning)">Morning 🌅</option>
                            <option value="@TimeOfDay.Afternoon" selected="@(settings.PreferredDeepWorkTime == TimeOfDay.Afternoon)">Afternoon ☀️</option>
                            <option value="@TimeOfDay.Evening" selected="@(settings.PreferredDeepWorkTime == TimeOfDay.Evening)">Evening 🌇</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Preferred Study Time</label>
                        <select name="preferredStudyTime">
                            <option value="@TimeOfDay.Morning" selected="@(settings.PreferredStudyTime == TimeOfDay.Morning)">Morning 🌅</option>
                            <option value="@TimeOfDay.Afternoon" selected="@(settings.PreferredStudyTime == TimeOfDay.Afternoon)">Afternoon ☀️</option>
                            <option value="@TimeOfDay.Evening" selected="@(settings.PreferredStudyTime == TimeOfDay.Evening)">Evening 🌇</option>
                        </select>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Theme</label>
                        <select name="theme">
                            <option value="dark" selected="@(settings.Theme == "dark")">Dark Theme</option>
                            <option value="light" selected="@(settings.Theme == "light")">Light Theme</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Timezone</label>
                        <input type="text" name="timezone" value="@settings.Timezone" />
                    </div>
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-2);">
                    <input type="checkbox" name="notificationsEnabled" value="true" id="notificationsCheck" checked="@settings.NotificationsEnabled" style="width: auto;" />
                    <label for="notificationsCheck" class="form-label" style="margin-bottom: 0;">Enable Notifications</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('editPreferencesModal').classList.remove('active')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Preferences</button>
            </div>
        </form>
    </div>
</div>
