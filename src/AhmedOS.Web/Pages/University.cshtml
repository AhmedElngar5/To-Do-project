@page
@using AhmedOS.Infrastructure.Data
@using AhmedOS.Domain.Enums
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AhmedOSDbContext Db
@inject UserManager<ApplicationUser> UserManager
@model AhmedOS.Web.Pages.UniversityModel
@{
    ViewData["Title"] = "University";
    var userId = UserManager.GetUserId(User);
    var courses = await Db.Courses.Where(c => c.UserId == userId).Include(c => c.Grades).Include(c => c.Tasks.Where(t => !t.IsDeleted)).OrderBy(c => c.Name).ToListAsync();
    var events = await Db.CalendarEvents.Where(e => e.UserId == userId && e.CourseId != null && e.StartTime >= DateTime.UtcNow).OrderBy(e => e.StartTime).Take(10).ToListAsync();
    var totalCredits = courses.Sum(c => c.CreditHours ?? 0);
    var avgProgress = courses.Count > 0 ? (int)courses.Average(c => c.Progress) : 0;
}

<div class="animate-fade-in">
    <div class="section-header">
        <div>
            <h1 class="section-title">🎓 University</h1>
            <p class="section-subtitle">Courses, grades, assignments, and academic progress</p>
        </div>
        <div>
            <button class="btn btn-primary btn-sm" onclick="document.getElementById('addCourseModal').classList.add('active')">
                ✚ Add Course
            </button>
        </div>
    </div>

    <!-- STATS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-6);">
        <div class="card card-compact"><div class="card-body stat-widget"><span class="stat-label">Courses</span><span class="stat-value">@courses.Count</span></div></div>
        <div class="card card-compact"><div class="card-body stat-widget"><span class="stat-label">Credit Hours</span><span class="stat-value">@totalCredits</span></div></div>
        <div class="card card-compact"><div class="card-body stat-widget"><span class="stat-label">Avg Progress</span><span class="stat-value">@avgProgress%</span></div></div>
        <div class="card card-compact"><div class="card-body stat-widget"><span class="stat-label">Upcoming Events</span><span class="stat-value">@events.Count</span></div></div>
    </div>

    <div class="widget-grid">
        <!-- COURSES -->
        <div class="card" style="grid-column: 1 / -1;">
            <div class="card-header">
                <span class="card-title">📚 My Courses</span>
            </div>
            <div class="card-body">
                @if (courses.Count == 0)
                {
                    <div class="empty-state" style="padding: var(--space-8) var(--space-4);">
                        <div class="empty-state-icon">🎓</div>
                        <div class="empty-state-title">No courses yet</div>
                        <div class="empty-state-text">Add your university courses to track grades and assignments.</div>
                    </div>
                }
                else
                {
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4);">
                        @foreach (var course in courses)
                        {
                            var gradeCount = course.Grades.Count;
                            var avgGrade = gradeCount > 0 ? course.Grades.Where(g => g.Score.HasValue && g.MaxScore.HasValue && g.MaxScore > 0).Select(g => (g.Score!.Value / g.MaxScore!.Value) * 100).DefaultIfEmpty(0).Average() : 0;
                            var taskCount = course.Tasks.Count(t => t.Status != TodoTaskStatus.Completed);
                            <div class="card" style="border-left: 3px solid @(course.Color ?? "var(--color-primary)");">
                                <div class="card-body" style="padding: var(--space-4);">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-2);">
                                        <div>
                                            <div style="font-weight: var(--weight-semibold); font-size: var(--text-base);">@course.Name</div>
                                            @if (!string.IsNullOrEmpty(course.Code))
                                            {
                                                <div class="text-xs text-tertiary" style="margin-top: 2px;">@course.Code</div>
                                            }
                                        </div>
                                        <span class="badge badge-neutral">@(course.Semester ?? "—")</span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(course.Instructor))
                                    {
                                        <div class="text-sm text-secondary" style="margin-bottom: var(--space-2);">👨‍🏫 @course.Instructor</div>
                                    }

                                    <div class="progress-bar" style="margin-bottom: var(--space-2);">
                                        <div class="progress-bar-fill" style="width: @course.Progress%; background: @(course.Color ?? "var(--color-primary)");"></div>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; font-size: var(--text-xs); color: var(--text-tertiary);">
                                        <span>Progress: @course.Progress%</span>
                                        <span>@(course.CreditHours ?? 0) credits</span>
                                    </div>

                                    <!-- Grades summary -->
                                    <div style="display: flex; gap: var(--space-3); margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--border-secondary);">
                                        <div style="flex: 1; text-align: center;">
                                            <div class="text-xs text-tertiary">Grades</div>
                                            <div style="font-weight: var(--weight-semibold);">@gradeCount</div>
                                        </div>
                                        <div style="flex: 1; text-align: center;">
                                            <div class="text-xs text-tertiary">Avg</div>
                                            <div style="font-weight: var(--weight-semibold);">@(gradeCount > 0 ? $"{avgGrade:F0}%" : "—")</div>
                                        </div>
                                        <div style="flex: 1; text-align: center;">
                                            <div class="text-xs text-tertiary">Tasks</div>
                                            <div style="font-weight: var(--weight-semibold);">@taskCount</div>
                                        </div>
                                    </div>

                                    <!-- Grades list -->
                                    @if (gradeCount > 0)
                                    {
                                        <div style="margin-top: var(--space-3);">
                                            @foreach (var grade in course.Grades.OrderByDescending(g => g.Date))
                                            {
                                                var pct = grade.MaxScore > 0 ? (grade.Score / grade.MaxScore * 100) : null;
                                                var color = pct switch { >= 85 => "var(--color-success)", >= 70 => "var(--color-info)", >= 50 => "var(--color-warning)", _ => "var(--color-danger)" };
                                                <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-1) 0; font-size: var(--text-sm);">
                                                    <div>
                                                        <span style="color: var(--text-secondary);">@grade.Name</span>
                                                        @if (!string.IsNullOrEmpty(grade.Type))
                                                        {
                                                            <span class="badge badge-neutral" style="font-size: 10px; padding: 1px 6px; margin-left: 4px;">@grade.Type</span>
                                                        }
                                                    </div>
                                                    <div style="font-weight: var(--weight-medium); color: @(pct.HasValue ? color : "var(--text-secondary)");">
                                                        @(grade.Score.HasValue ? $"{grade.Score}/{grade.MaxScore}" : "—")
                                                        @if (pct.HasValue)
                                                        {
                                                            <span style="font-size: var(--text-xs); margin-left: 4px;">(@($"{pct:F0}")%)</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <!-- Add grade action -->
                                    <div style="margin-top: var(--space-3); padding-top: var(--space-2); border-top: 1px dashed var(--border-secondary); display: flex; justify-content: flex-end;">
                                        <button type="button" class="btn btn-ghost btn-xs" onclick="openGradeModal(@course.Id, '@course.Name')" style="font-size: 11px;">
                                            ✚ Add Grade
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- UPCOMING EVENTS -->
        <div class="card">
            <div class="card-header"><span class="card-title">📅 Upcoming</span></div>
            <div class="card-body">
                @if (events.Count == 0)
                {
                    <p class="text-sm text-secondary" style="padding: var(--space-3);">No upcoming academic events.</p>
                }
                @foreach (var ev in events)
                {
                    var typeClass = ev.EventType switch { CalendarEventType.Exam => "badge-danger", CalendarEventType.Assignment => "badge-warning", CalendarEventType.Class => "badge-info", _ => "badge-neutral" };
                    <div style="padding: var(--space-2) 0; border-bottom: 1px solid var(--border-secondary);">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: var(--text-sm); font-weight: var(--weight-medium);">@ev.Title</span>
                            <span class="badge @typeClass">@ev.EventType</span>
                        </div>
                        <div class="text-xs text-tertiary" style="margin-top: 2px;">@ev.StartTime.ToString("ddd, MMM d · h:mm tt")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ADD COURSE MODAL -->
<div class="modal-overlay" id="addCourseModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">🎓 Add University Course</h3>
            <button type="button" class="modal-close" onclick="document.getElementById('addCourseModal').classList.remove('active')">✕</button>
        </div>
        <form method="post" asp-page-handler="AddCourse">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Course Name *</label>
                    <input type="text" name="name" required placeholder="e.g. Distributed Systems, Machine Learning" autofocus />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Course Code</label>
                        <input type="text" name="code" placeholder="e.g. CS401, MATH201" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Professor / Instructor</label>
                        <input type="text" name="instructor" placeholder="Dr. ..." />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Semester</label>
                        <input type="text" name="semester" value="Spring 2026" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Credit Hours</label>
                        <input type="number" name="creditHours" value="3" min="1" max="6" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Color Tag</label>
                    <input type="color" name="color" value="#3b82f6" style="height: 38px; padding: 2px; width: 100%;" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('addCourseModal').classList.remove('active')">Cancel</button>
                <button type="submit" class="btn btn-primary">Add Course</button>
            </div>
        </form>
    </div>
</div>

<!-- ADD GRADE MODAL -->
<div class="modal-overlay" id="addGradeModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title" id="gradeModalTitle">📝 Add Grade</h3>
            <button type="button" class="modal-close" onclick="document.getElementById('addGradeModal').classList.remove('active')">✕</button>
        </div>
        <form method="post" asp-page-handler="AddGrade">
            @Html.AntiForgeryToken()
            <input type="hidden" name="courseId" id="gradeCourseId" />
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Assessment Title *</label>
                    <input type="text" name="name" required placeholder="e.g. Midterm Exam, Assignment 1, Quiz 2" />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Type</label>
                        <select name="type">
                            <option value="Assignment">Assignment</option>
                            <option value="Midterm">Midterm Exam</option>
                            <option value="Quiz">Quiz</option>
                            <option value="Project">Project / Lab</option>
                            <option value="Final">Final Exam</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Weight (%)</label>
                        <input type="number" name="weight" value="15" min="1" max="100" />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Score Earned *</label>
                        <input type="number" step="0.5" name="score" required placeholder="18" min="0" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Max Score *</label>
                        <input type="number" step="0.5" name="maxScore" required placeholder="20" min="1" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('addGradeModal').classList.remove('active')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Grade</button>
            </div>
        </form>
    </div>
</div>

<script>
function openGradeModal(courseId, courseName) {
    document.getElementById('gradeCourseId').value = courseId;
    document.getElementById('gradeModalTitle').textContent = '📝 Add Grade — ' + courseName;
    document.getElementById('addGradeModal').classList.add('active');
}
</script>
